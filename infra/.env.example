# Copy to `infra/.env` and fill in. `infra/.env` is gitignored.
#
# GCP_API_KEY: create one in the Google Cloud Console — see the README
# section "Generate a Google Cloud API key". Leave empty to run the app
# without speech recognition.
GCP_API_KEY=

# Host ports (loopback only). Change if something already uses them.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Must match the URL the browser uses to reach the backend.
API_BASE_URL=http://localhost:8000

DATABASE_NAME=speechtonote
BACKEND_DEBUG=false